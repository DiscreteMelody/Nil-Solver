<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio project for the shared library.

  CMake is the reference build and the one CI runs; this file exists so that
  "open Nil-Solver.slnx, pick Release|x64, Build" produces the same DLL without
  needing CMake on the machine.  The two agree on the things that matter: the
  same source list, C++17, /W4 /permissive-, and NIL_SOLVER_BUILD_DLL so the
  header's __declspec resolves to dllexport rather than dllimport.

  It used to be the stock "Dynamic-Link Library" template - dllmain.cpp and
  pch.cpp and nothing else.  That built, and produced a DLL with no exports at
  all, which is a worse failure than not building: everything looks fine until
  the first DllImport throws EntryPointNotFoundException at run time.

  Output lands in build-vs\bin\$(Platform)\$(Configuration)\, deliberately not
  in build\, so a CMake tree and an IDE tree can coexist without either one
  overwriting the other's nil_solver.dll.

  Precompiled headers are off.  The core sources are shared with CMake and with
  the non-Windows build, so they do not include pch.h and cannot be made to.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{cebb5a0e-5636-4d08-864c-f38a67176fc1}</ProjectGuid>
    <RootNamespace>NilSolver</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <!-- nil_solver.dll, so [DllImport("nil_solver")] finds it and so the name
         matches what CMake produces.  Without this the DLL is named after the
         project and the C# side has to know which build system made it. -->
    <TargetName>nil_solver</TargetName>
    <OutDir>$(ProjectDir)build-vs\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)build-vs\obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <!-- Shared with the CMake build, which does not use a PCH. -->
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- NIL_SOLVER_BUILD_DLL is the one that matters: it makes NIL_SOLVER_API
           expand to __declspec(dllexport).  Leave it out and the build succeeds
           and exports nothing. -->
      <PreprocessorDefinitions>NIL_SOLVER_BUILD_DLL;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Set explicitly rather than left to the toolset default.  This is a
           search: an unoptimised build is not slightly slower, it is orders of
           magnitude slower, and a benchmark taken from one is worthless. -->
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- Dynamic CRT, matching CMake's default, so the target machine needs the
           Visual C++ redistributable.  Change to MultiThreaded for a
           self-contained DLL with no redist dependency; see csharp/README.md. -->
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="include\nil_solver\nil_solver.h" />
    <ClInclude Include="src\nil\bounds.hpp" />
    <ClInclude Include="src\nil\cards.hpp" />
    <ClInclude Include="src\nil\corpus.hpp" />
    <ClInclude Include="src\nil\position.hpp" />
    <ClInclude Include="src\nil\rules.hpp" />
    <ClInclude Include="src\nil\search.hpp" />
    <ClInclude Include="src\nil\statekey.hpp" />
    <ClInclude Include="src\nil\tt.hpp" />
    <ClInclude Include="framework.h" />
    <ClInclude Include="pch.h" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exactly CMake's nil_solver_core plus src\api.cpp; keep the two lists in
         step, or the IDE build and the CI build stop being the same thing. -->
    <ClCompile Include="src\api.cpp" />
    <ClCompile Include="src\nil\cards.cpp" />
    <ClCompile Include="src\nil\corpus.cpp" />
    <ClCompile Include="src\nil\position.cpp" />
    <ClCompile Include="src\nil\search.cpp" />
    <ClCompile Include="src\nil\statekey.cpp" />
    <ClCompile Include="src\nil\tt.cpp" />
    <ClCompile Include="dllmain.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
